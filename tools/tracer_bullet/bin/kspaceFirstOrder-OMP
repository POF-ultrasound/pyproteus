#!/bin/sh
# Wrapper around k-wave-python's prebuilt k-Wave C++ OpenMP binary (v1.4.1).
# The macOS binary links Homebrew paths (/opt/homebrew/opt/{fftw,hdf5,libomp,zlib});
# when those are absent, dyld falls back to the libraries in KWAVE_LIBS
# (default: the conda prefix made by tools/tracer_bullet/setup_libs.sh).
# Used by both MATLAB k-Wave (BinaryPath) and k-wave-python (binary_path),
# so both sides run the very same executable.
here=$(cd "$(dirname "$0")" && pwd)
: "${KWAVE_LIBS:=$here/../.kwave-libs/lib}"
: "${KWAVE_BINARY:=$("${KWAVE_PYTHON:-$HOME/miniconda3/envs/pyproteus/bin/python}" -c 'import kwave; print(kwave.BINARY_PATH / "kspaceFirstOrder-OMP")')}"
export DYLD_FALLBACK_LIBRARY_PATH="$KWAVE_LIBS${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
exec "$KWAVE_BINARY" "$@"
